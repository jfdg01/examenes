@startuml 3-nucleo
!pragma layout smetana
!include <C4/C4_Component>
title 3. Los componentes de nucleo: dónde vive cada regla\nTodo está en lib.rs, y wasm.rs lo publica al navegador

Container(interfaz, "interfaz", "Svelte")
Container(servidor, "servidor", "axum")
Container(banco, "banco", "CLI")

Container_Boundary(nucleo, "nucleo") {
  Component(wasm, "wasm.rs", "wasm-bindgen, tsify", "Las funciones del navegador, y los tipos de TypeScript")
  Component(tipos, "Los datos", "", "Examen, Pregunta, Respuesta, Datos, Guardado, Nota")
  Component(paso, "El paso", "", "Concepto, el vencimiento y corregir()")
  Component(ronda, "La ronda", "", "sesion(), simulacro(), restante() y Azar")
  Component(guardado, "El guardado", "", "gana(), unir() y restaurar()")
  Component(nota, "La nota", "", "inicio(), tarjeta() y nota_del_simulacro()")
  Component(edicion, "La edición", "", "editar(): los textos de una pregunta desde el test")
  Component(columnas, "Las columnas", "", "columnas() y mover()")
}

Rel(interfaz, wasm, "Llama")
Rel(wasm, paso, "")
Rel(wasm, ronda, "")
Rel(wasm, guardado, "")
Rel(wasm, nota, "")
Rel(wasm, edicion, "")
Rel(wasm, columnas, "")
Rel(ronda, paso, "Elige por vencimiento")
Rel(nota, paso, "Cuenta los conceptos en «sabes»")
Rel(servidor, tipos, "Valida con")
Rel(servidor, guardado, "gana()")
Rel(banco, tipos, "Valida con")
@enduml
