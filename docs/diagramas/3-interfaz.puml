@startuml 3-interfaz
!pragma layout smetana
!include <C4/C4_Component>
title 3. Los componentes de la interfaz: qué pantalla hace qué

Container(servidor, "servidor", "axum")
Container(nucleo, "nucleo", "WASM")

Container_Boundary(interfaz, "interfaz") {
  Component(main, "main.ts", "", "Carga nucleo y monta Lista en /, Plan en /?plan o App en /<carpeta>/")
  Component(pomodoro, "Pomodoro.svelte", "", "El botón del cronómetro de pausas, en la línea de arriba de cada pantalla menos en un simulacro: 25 de estudio, 5 de pausa y 20 tras cada 3. Vive en localStorage")
  Component(lista, "Lista.svelte", "", "La lista de exámenes")
  Component(plan, "Plan.svelte", "", "El plan de estudio de ASN y PS, con las sesiones hechas de cada día")
  Component(app, "App.svelte", "", "La ronda: carga, guarda, corrige y envía. Todo el estado vive aquí")
  Component(inicio, "Inicio.svelte", "", "La selección de apartados, la tarjeta de la nota y los botones de empezar")
  Component(pregunta, "Pregunta.svelte", "", "Una pregunta, su solución y su edición")
  Component(final, "Final.svelte", "", "La nota del simulacro y la cuadrícula en verde y rojo")
  Component(cuadricula, "Cuadricula.svelte", "", "Los números de la ronda, para saltar a una pregunta")
  Component(hoja, "Hoja.svelte", "", "La página del PDF junto a la pregunta, en el PC")
  Component(pagina, "PaginaCompleta.svelte", "", "La página del PDF a pantalla completa")
  Component(tiradores, "Tiradores.svelte", "", "Los separadores de las 2 columnas del PC")
}

Rel(main, lista, "Monta en /")
Rel(main, app, "Monta en /<carpeta>/")
Rel(lista, servidor, "api/examenes")
Rel(main, plan, "Monta en /?plan")
Rel(plan, servidor, "asn/api/inicio y ps/api/inicio")
Rel(app, inicio, "")
Rel(app, pregunta, "")
Rel(app, final, "")
Rel(app, hoja, "")
Rel(app, pagina, "")
Rel(app, tiradores, "")
Rel(pregunta, cuadricula, "")
Rel(final, cuadricula, "")
Rel(lista, pomodoro, "")
Rel(plan, pomodoro, "")
Rel(inicio, pomodoro, "")
Rel(pregunta, pomodoro, "Fuera del simulacro")
Rel(final, pomodoro, "")
Rel(app, nucleo, "Cada cálculo")
Rel(app, servidor, "Cada lectura y escritura")
@enduml
