' Los diagramas de app/: las clases de nucleo, el servidor y la interfaz, la ronda y el viaje de una sesión.
' Un cambio de un tipo, una función, una ruta o una dependencia entre las 3 partes actualiza este archivo en el mismo commit.
' En VS Code, la extensión jebbs.plantuml abre la vista previa del diagrama bajo el cursor con Alt+D.
' `smetana` dibuja el diagrama sin Graphviz.

@startuml las-clases
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam shadowing false
title Las clases de app/\n+ es público, - es privado, <<tsify>> sale a interfaz/src/nucleo/ como tipo de TypeScript
left to right direction

package nucleo {
  class Examen <<examen.json, tsify>> {
    +titulo: String
    +preguntas: u32
    +opciones: u32
    +minutos: u32
    +penalizacion: f64
  }
  class Pregunta <<preguntas.json, tsify>> {
    +id: String
    +concepto: String
    +tema: String
    +pregunta: String
    +correcta: String
    +distractores: Vec<String>
    +explicacion: String
  }
  class Respuesta <<una línea de respuestas.jsonl, tsify>> {
    +id: String
    +ts: String
    +resultado: Resultado
    +seguro: bool
  }
  class Datos <<tsify>> {
    +examen: Examen
    +banco: Vec<Pregunta>
    +historial: Vec<Respuesta>
  }
  enum Concepto {
    SinVer
    Paso(u32)
    --
    +tras(acierto, seguro): Concepto
    +hueco(): i64
    +to_string(): "sin ver" o "paso n"
  }
  class Azar {
    -semilla: u64
    +new(semilla): Azar
    -hasta(n): usize
    -barajar(lista)
  }
  enum Inicio <<tsify>> {
    BancoVacio { titulo }
    Listo { titulo, sesion, simulacro, tarjeta }
  }
  class Simulacro <<tsify>> {
    +segundos: u32
    +preguntas: Vec<PreguntaDeSesion>
  }
  enum Resultado <<tsify>> {
    Acierto
    Fallo
    Blanco
  }
  class Cierre <<tsify>> {
    +preguntas: u32
    +resultados: Vec<Resultado>
  }
  class NotaDelSimulacro <<tsify>> {
    +aciertos: u32
    +fallos: u32
    +en_blanco: u32
    +nota: String
  }
  class Tarjeta <<tsify>> {
    +sabes: u32
    +no_sabes: u32
    +sin_ver: u32
    +hoy: u32
    +meta: u32
    +sesiones: String
    +consejo: String
    +si_contestas: u32
    +en_blanco: u32
    +dudas: Vec<Dudas>
  }
  class Dudas <<tsify>> {
    +texto: String
    +conceptos: u32
    +porcentaje: u32
    +detalle: Option<String>
  }
  class PreguntaDeSesion <<tsify>> {
    +id: String
    +tema: String
    +concepto: String
    +pregunta: String
    +opciones: Vec<String>
    +correcta: u32
    +explicacion: String
    +paso: String
    +paso_tras_seguro: String
    +paso_tras_otra: String
  }
  enum Ronda <<tsify>> {
    Inicio
    Pregunta { contestada }
    Final
  }
  class "nucleo (funciones)" as funciones <<lib.rs>> {
    -TAMANO_SESION = 12
    -HUECOS_SIN_VER = 4
    -META = 0.95
    -VENTANA = 60
    +inicio(examen, banco, historial, objetivo): Inicio
    +tarjeta(examen, banco, historial, objetivo): Tarjeta
    +sesion(banco, historial, ahora, azar): Vec<PreguntaDeSesion>
    +simulacro(examen, banco, historial, azar): Simulacro
    +nota_del_simulacro(cierre, penalizacion): NotaDelSimulacro
    +corregir(pregunta, opcion, seguro, ahora): Respuesta
    +restante(empieza, segundos, ahora): ms
    +segundos(ts): Option<i64>
    +hora(segundos): ts
    -estados(banco, historial): concepto → (Concepto, vence)
    -de_la_ronda(pregunta, estados, azar): PreguntaDeSesion
    -cuenta(banco, historial): (sabes, no sabes, sin ver)
    -probabilidad(sabes, acierto, objetivo, examen): f64
    -binomial(n, k, p): f64
  }
  class "wasm.rs" as wasm <<wasm-bindgen>> {
    las horas van en ms, como Date.now()
    --
    +inicio(datos, objetivo): Inicio
    +sesion(datos, ahora): PreguntaDeSesion[]
    +simulacro(datos, ahora): Simulacro
    +corregir(pregunta, opcion, seguro, ahora): Respuesta
    +restante(empieza, segundos, ahora): ms
    +nota(cierre, penalizacion): NotaDelSimulacro
    -azar(ahora): Azar, con la hora de semilla
  }
}

package servidor {
  class Carpetas {
    -raiz: PathBuf
    -interfaz: PathBuf
    -historial: Mutex
  }
  class "rutas (axum)" as rutas {
    +app(raiz, interfaz): Router
    --
    GET /:examen → 308 /:examen/
    GET /:examen/ → pagina → index.html
    GET /:examen/api/inicio → inicio → Datos
    POST /:examen/api/respuestas → responder → 204
    GET /assets/* → dist/assets
    todo va con gzip
  }
  class "lectura" as lectura {
    -leer_examen(carpetas, examen): Examen
    -leer_banco(carpetas, examen): Vec<Pregunta>
    -leer_historial(carpetas, examen): Vec<Respuesta>
    -leer_si_existe(ruta): bytes
    -error_interno(e): 500
  }
}

package interfaz {
  class "App.svelte" as App {
    -datos: Datos
    -inicio: Inicio, de nucleo.inicio(datos, objetivo)
    -objetivo: number, en localStorage <examen>-objetivo
    -ronda: Ronda
    -preguntas: PreguntaDeSesion[]
    -i: number
    -eleccion: { opcion o null, respuesta }
    -error: string
    -simulacro: boolean
    -resultados: Resultado[]
    -nota: NotaDelSimulacro
    -empieza: ms
    -segundos: number
    -restante: ms
    --
    -empezar(comoSimulacro)
    -contar(), cada segundo
    -contestar(opcion o null, seguro)
    -siguiente()
    -terminar()
    -cargarInicio()
    -volver()
    -abandonar()
  }
  class "nucleo/nucleo.js y nucleo.d.ts" as generado <<generado>> {
    las funciones de wasm.rs
    los tipos <<tsify>>
  }
}

funciones ..> Examen : lee
funciones ..> Pregunta : lee
funciones ..> Respuesta : lee
funciones ..> Concepto : calcula el paso
funciones ..> Azar : baraja
funciones --> Inicio : devuelve
Inicio *-- Tarjeta
Tarjeta *-- Dudas
funciones --> PreguntaDeSesion : devuelve
funciones --> Simulacro : devuelve
Simulacro *-- PreguntaDeSesion
funciones ..> Cierre : lee
Cierre *-- Resultado
Respuesta *-- Resultado
Datos *-- Examen
Datos *-- Pregunta
Datos *-- Respuesta
funciones --> NotaDelSimulacro : devuelve
rutas *-- Carpetas : estado
rutas ..> lectura : lee la carpeta
rutas ..> Datos : devuelve
rutas ..> Respuesta : valida
wasm ..> funciones : llama
wasm ..> generado : wasm-bindgen genera
App ..> generado : importa y llama
App ..> rutas : HTTP
@enduml

@startuml la-ronda
!pragma layout smetana
skinparam shadowing false
title La ronda en App.svelte\nCada flecha lleva la función que hace el cambio

state Inicio
state "Pregunta { contestada: false }" as SinContestar
state "Pregunta { contestada: true }" as Contestada
state Final

[*] --> Inicio
Inicio --> SinContestar : empezar(comoSimulacro)
SinContestar --> Contestada : contestar(opcion, seguro)
SinContestar --> Contestada : contestar(null), "En blanco" del simulacro
Contestada --> SinContestar : siguiente(), quedan preguntas
Contestada --> Final : siguiente() → terminar(), la última
SinContestar --> Final : contar() → terminar(), el límite del simulacro
Contestada --> Final : contar() → terminar(), el límite del simulacro
SinContestar --> Inicio : abandonar(), el botón ✕
Contestada --> Inicio : abandonar(), el botón ✕
Final --> Inicio : volver()
@enduml

@startuml el-viaje-de-una-sesion
skinparam shadowing false
title El viaje de una sesión

participant "App.svelte" as App
participant "nucleo (WASM)" as N
participant servidor as S
database "carpeta del examen" as C

App -> S : GET api/inicio
S -> C : examen.json, preguntas.json, respuestas.jsonl
S --> App : Datos { examen, banco, historial }
App -> N : inicio(datos, objetivo)
N --> App : Inicio (BancoVacio o Listo)

App -> N : sesion(datos, Date.now())
N --> App : 12 PreguntaDeSesion

loop cada pregunta
  App -> N : corregir(pregunta, opcion, seguro, Date.now())
  N --> App : Respuesta, en blanco sin opción
  App -> S : POST api/respuestas [id, ts, resultado, seguro]
  S -> C : añade a respuestas.jsonl la que no está
  S --> App : 204
  note over App : muestra paso_tras_seguro o paso_tras_otra
end
@enduml

@startuml el-final-de-un-simulacro
skinparam shadowing false
title El final de un simulacro

participant "App.svelte" as App
participant "nucleo (WASM)" as N
participant servidor as S

App -> N : simulacro(datos, Date.now())
N --> App : Simulacro { segundos, preguntas }
note over App : empieza = Date.now()
loop cada segundo, contar()
  App -> N : restante(empieza, segundos, Date.now())
  N --> App : ms que quedan; a 0, terminar()
end
note over App : cada respuesta va a POST api/respuestas, como en la sesión;\nuna pregunta sin contestar al pasar el límite no va
App -> N : nota({ preguntas, resultados }, penalizacion)
note over N : cada pregunta sin resultado cuenta en blanco
N --> App : NotaDelSimulacro
@enduml
