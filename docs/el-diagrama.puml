@startuml la-ronda
!pragma layout smetana
skinparam shadowing false
title La ronda en App.svelte\nCada flecha lleva la función que hace el cambio\nempezar, contestar, terminar y volver llaman a guardar()

state Inicio
state "Pregunta { contestada: false }" as SinContestar
state "Pregunta { contestada: true }" as Contestada
state Final

[*] --> Inicio
[*] --> SinContestar : arrancar() → seguir(), con una ronda a medias
[*] --> Final : arrancar() → seguir() → terminar(), sin preguntas por contestar
Inicio --> SinContestar : empezar(comoSimulacro)
SinContestar --> Contestada : contestar(opcion, seguro)
SinContestar --> Contestada : contestar(null), "En blanco" del simulacro
Contestada --> SinContestar : siguiente() o ir(k), a una sin contestar
SinContestar --> Contestada : ir(k), a una contestada
Contestada --> Final : intentarTerminar() → terminar(), todas contestadas
SinContestar --> Final : contar() → terminar(), el límite del simulacro
Contestada --> Final : contar() → terminar(), el límite del simulacro
SinContestar --> Inicio : abandonar(), el botón ✕
Contestada --> Inicio : abandonar(), el botón ✕
Final --> Final : onrevisar(k) y siguiente(), la revisión de una pregunta
Final --> Inicio : volver()
@enduml

@startuml abrir-un-examen
skinparam shadowing false
title Abrir un examen: arrancar() en App.svelte\nEl dispositivo y el servidor acaban con el mismo historial y la misma ronda

participant "App.svelte" as App
database localStorage as L
participant "nucleo (WASM)" as N
participant servidor as S

App -> S : POST api/respuestas, con las pendientes de L
App -> S : GET api/inicio
S --> App : Datos { examen, banco, historial }
App -> N : unir(historial, pendientes)
App -> S : GET api/ronda
App -> L : la ronda de este dispositivo
App -> N : gana(servidor, local)
N --> App : el guardado más nuevo
App -> S : PUT api/ronda, con el guardado que gana
App -> L : el guardado que gana
App -> N : restaurar(datos, guardado)
alt con una ronda a medias
  N --> App : RondaAMedias: sigue en la primera sin contestar
else sin ronda
  N --> App : null: la pantalla del inicio
end
@enduml

@startuml contestar-una-pregunta
skinparam shadowing false
title Contestar una pregunta: contestar() en App.svelte\nUna respuesta sin red espera en localStorage, y no se pierde

participant "App.svelte" as App
participant "nucleo (WASM)" as N
database localStorage as L
participant servidor as S

App -> N : corregir(pregunta, opcion, seguro, ahora)
N --> App : Correccion: el resultado, el paso nuevo y el aviso
App -> L : guardar(): la ronda
App -> S : guardar(): PUT api/ronda
App -> L : añade la respuesta a las pendientes
App -> N : unir(historial, [respuesta])
App -> S : POST api/respuestas, con todas las pendientes
alt con red
  S --> App : 204
  App -> L : quita las enviadas
else sin red
  note over App : las pendientes salen con el evento online o en la carga siguiente
end
@enduml
