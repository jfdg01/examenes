' Los diagramas de app/: las clases de nucleo, el servidor, banco y la interfaz, la ronda y el viaje de una sesión.
' Un cambio de un tipo, una función, una ruta o una dependencia entre las 4 partes actualiza este archivo en el mismo commit.
' En VS Code, la extensión jebbs.plantuml abre la vista previa del diagrama bajo el cursor con Alt+D.
' `smetana` dibuja el diagrama sin Graphviz.

@startuml las-clases
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam shadowing false
title Las clases de app/\n+ es público, - es privado, <<tsify>> sale a interfaz/src/nucleo/ como tipo de TypeScript
left to right direction

package nucleo {
  class Examen <<examen.json, tsify>> {
    +titulo: String
    +preguntas: u32
    +opciones: u32
    +minutos: u32
    +penalizacion: f64
  }
  class Pregunta <<preguntas.json, tsify>> {
    +id: String
    +concepto: String
    +tema: String
    +pregunta: String
    +correcta: String
    +distractores: Vec<String>
    +explicacion: String
    +fuente: Fuente
  }
  class Fuente <<tsify>> {
    +pdf: String
    +pagina: u32
  }
  class Respuesta <<una línea de respuestas.jsonl, tsify>> {
    +id: String
    +ts: String
    +resultado: Resultado
    +seguro: bool
  }
  class Nota <<un par de notas.json, tsify>> {
    +id: String
    +texto: String, en blanco la borra
  }
  class Datos <<tsify>> {
    +examen: Examen
    +banco: Vec<Pregunta>
    +historial: Vec<Respuesta>
  }
  enum Concepto {
    SinVer
    Paso(u32)
    --
    +tras(acierto, seguro): Concepto
    +hueco(): i64
    +to_string(): "sin ver" o "paso n"
  }
  class Azar {
    -semilla: u64
    +new(semilla): Azar
    -hasta(n): usize
    -barajar(lista)
  }
  enum Inicio <<tsify>> {
    BancoVacio { titulo }
    Listo { titulo, sesion, simulacro, tarjeta }
  }
  class Simulacro <<tsify>> {
    +segundos: u32
    +preguntas: Vec<PreguntaDeSesion>
  }
  enum Resultado <<tsify>> {
    Acierto
    Fallo
    Blanco
  }
  class Cierre <<tsify>> {
    +preguntas: u32
    +resultados: Vec<Resultado>
  }
  class Correccion <<tsify>> {
    +respuesta: Respuesta
    +paso: String, el del concepto tras la respuesta
    +aviso: Option<String>, con un fallo con «seguro» o un acierto con «dudo»
  }
  class NotaDelSimulacro <<tsify>> {
    +aciertos: u32
    +fallos: u32
    +en_blanco: u32
    +nota: String
  }
  class Tarjeta <<tsify>> {
    +sabes: u32
    +no_sabes: u32
    +sin_ver: u32
    +hoy: u32
    +meta: u32
    +sesiones: String
    +consejo: String
    +si_contestas: u32
    +en_blanco: u32
    +dudas: Vec<Dudas>
  }
  class Dudas <<tsify>> {
    +texto: String
    +conceptos: u32
    +porcentaje: u32
    +detalle: Option<String>
  }
  class PreguntaDeSesion <<tsify>> {
    +id: String
    +tema: String
    +concepto: String
    +pregunta: String
    +opciones: Vec<String>
    +correcta: u32
    +explicacion: String
    +paso: String
    +paso_tras_seguro: String
    +paso_tras_otra: String
    +fuente: String, "<pdf> · pág. n"
    +pagina: u32
    +imagen: String, paginas/<pdf sin .pdf>-<n>.png
    +pdf: String, pdfs/<pdf>#page=<n>
    +copiar: String, la pregunta y "A) …" por opción, sin la solución
  }
  class Columnas <<localStorage <examen>-columnas, tsify>> {
    +l: f64, el borde izquierdo
    +s: f64, el separador
    +r: f64, el borde derecho
    las 3, en fracción del ancho
  }
  enum Tirador <<tsify>> {
    L
    S
    R
  }
  class Guardado <<ronda.json, localStorage <examen>-ronda, tsify>> {
    +guardada: u64, en ms
    +ronda: Option<RondaGuardada>
  }
  class RondaGuardada <<tsify>> {
    +ids: Vec<String>
    +resultados: Vec<Resultado>
    +simulacro: bool
    +limite: Option<u64>, en ms
  }
  class RondaAMedias <<tsify>> {
    +preguntas: Vec<PreguntaDeSesion>
    +resultados: Vec<Resultado>
    +simulacro: bool
    +limite: Option<u64>, en ms
  }
  enum Ronda <<tsify>> {
    Inicio
    Pregunta { contestada }
    Final
  }
  class "nucleo (funciones)" as funciones <<lib.rs>> {
    -TAMANO_SESION = 12
    -HUECOS_SIN_VER = 4
    -META = 0.95
    -VENTANA = 60
    +inicio(examen, banco, historial, objetivo): Inicio
    +tarjeta(examen, banco, historial, objetivo): Tarjeta
    +sesion(banco, historial, ahora, azar): Vec<PreguntaDeSesion>
    +simulacro(examen, banco, historial, azar): Simulacro
    +nota_del_simulacro(cierre, penalizacion): NotaDelSimulacro
    +corregir(pregunta, opcion, seguro, ahora): Correccion
    +restante(limite, ahora): segundos
    +gana(a, b): Guardado
    +unir(a, b): Vec<Respuesta>, en orden de hora y sin repetir id y ts
    +restaurar(banco, historial, guardado, azar): Option<RondaAMedias>
    +mover(columnas, tirador, x): Columnas, con cada columna de 0,15 como mínimo
    +segundos(ts): Option<i64>
    +hora(segundos): ts
    -estados(banco, historial): concepto → (Concepto, vence)
    -de_la_ronda(pregunta, estados, azar): PreguntaDeSesion
    -sube(acierto, seguro): bool, solo con un acierto con «seguro»
    -cuenta(banco, historial): (sabes, no sabes, sin ver)
    -probabilidad(sabes, acierto, objetivo, examen): f64
    -binomial(n, k, p): f64
  }
  class "wasm.rs" as wasm <<wasm-bindgen>> {
    las horas van en ms, como Date.now()
    --
    +inicio(datos, objetivo): Inicio
    +sesion(datos, ahora): PreguntaDeSesion[]
    +simulacro(datos, ahora): Simulacro
    +corregir(pregunta, opcion, seguro, ahora): Correccion
    +restante(limite, ahora): segundos
    +gana(a, b): Guardado
    +unir(a, b): Respuesta[]
    +restaurar(datos, guardado, ahora): RondaAMedias o undefined
    +nota(cierre, penalizacion): NotaDelSimulacro
    +columnas(): Columnas, las de partida
    +mover(columnas, tirador, x): Columnas
    -azar(ahora): Azar, con la hora de semilla
  }
}

package servidor {
  class Carpetas {
    -raiz: PathBuf
    -interfaz: PathBuf
    -cerrojo: Mutex, del historial, la ronda y las notas
  }
  class "rutas (axum)" as rutas {
    +app(raiz, interfaz): Router
    --
    GET /:examen → 308 /:examen/
    GET /:examen/ → pagina → index.html
    GET /:examen/api/inicio → inicio → Datos
    POST /:examen/api/respuestas → responder → 204
    GET /:examen/api/ronda → leer_ronda → Guardado
    PUT /:examen/api/ronda → guardar_ronda → 204
    GET /:examen/api/notas → leer_notas → id → texto
    POST /:examen/api/notas → anotar(Nota) → 204
    GET /:examen/paginas/:archivo → servir → image/png
    GET /:examen/pdfs/:archivo → servir → application/pdf
    GET /assets/* → dist/assets
    todo va con gzip
  }
  class "lectura" as lectura {
    -leer_examen(carpetas, examen): Examen
    -leer_banco(carpetas, examen): Vec<Pregunta>
    -leer_historial(carpetas, examen): Vec<Respuesta>
    -un_nombre(nombre): bool, un nombre sin / ni punto delante
    -servir(carpetas, examen, carpeta, archivo, tipo): el archivo o 404
    -leer_si_existe(ruta): bytes
    -leer_archivo_de_notas(ruta): id → texto
    -error_interno(e): 500
  }
}

package banco {
  class "Examen (banco)" as ExamenBanco {
    +opciones: u32
    +pdfs: pdf → temas
  }
  class "banco (funciones)" as herramientas <<lib.rs>> {
    +informe(carpeta): bool, sin errores; escribe los errores y los avisos
    +comprobar(preguntas, examen, carpeta): errores
    +pistas(preguntas): avisos de la regla 6
    +huerfanas(preguntas, historial): id fuera del banco
    +sacar(carpeta): paginas/<pdf>-<página>.png a 80 ppp
    +paginas(pdf): u32, de pdfinfo
  }
  class "main.rs" as ordenes {
    banco comprobar <carpeta>
    banco paginas <carpeta>
  }
}

package interfaz {
  class "App.svelte" as App {
    -datos: Datos
    -inicio: Inicio, de nucleo.inicio(datos, objetivo)
    -objetivo: number, en localStorage <examen>-objetivo
    -ronda: Ronda
    -preguntas: PreguntaDeSesion[]
    -i: number
    -eleccion: { opcion o null, respuesta }
    -error: string
    -simulacro: boolean
    -resultados: Resultado[]
    -nota: NotaDelSimulacro
    -limite: ms
    -restante: segundos
    -columnas: Columnas, en localStorage <examen>-columnas
    -abiertas: boolean, las opciones plegadas del móvil
    -pagina: boolean, la página a pantalla completa del móvil
    -notas: id → texto, de GET api/notas
    -notasVisibles: boolean, en localStorage <examen>-notas-visibles
    --
    -arrancar(), al cargar la página
    -enviar(guardado), a localStorage <examen>-ronda y a PUT api/ronda
    -pendientes(): Respuesta[], de localStorage <examen>-pendientes
    -enviarPendientes(): error o "", en cola, a POST api/respuestas
    -guardar(), de empezar, contestar, terminar y volver
    -empezar(comoSimulacro)
    -seguir(), en la primera pregunta sin resultado
    -contar(), cada segundo
    -contestar(opcion o null, seguro)
    -siguiente()
    -verPagina(), con una entrada del historial; atrás la cierra
    -terminar()
    -cargarInicio(), al cargar, al volver y al volver la red
    -volver()
    -abandonar()
    -alternarNotas()
    -anotar(texto), a POST api/notas medio segundo después de la última tecla
  }
  class "Inicio.svelte" as InicioSvelte {
    inicio, objetivo, error
    onobjetivo(objetivo), onempezar(simulacro)
  }
  class "Pregunta.svelte" as PreguntaSvelte {
    la cabecera, la barra, las opciones y el pie
    q, i, total, simulacro, restante, eleccion, abiertas, nota, notasVisibles, error
    children: la hoja
    onabandonar(), oncontestar(opcion o null, seguro), onabiertas(), onnota(texto), onnotasvisibles(), onverpagina(), onsiguiente()
    -copiar(), q.copiar al portapapeles
  }
  class "Hoja.svelte" as Hoja {
    la explicación, la fuente y la imagen de la página
    q, paso: el de la corrección
  }
  class "Tiradores.svelte" as Tiradores {
    los 3 tiradores del PC
    onmover(tirador, x), onsoltar()
  }
  class "PaginaCompleta.svelte" as PaginaCompleta {
    la página a pantalla completa del móvil
    q, oncerrar()
    -zoom: boolean
  }
  class "Final.svelte" as Final {
    simulacro, nota, preguntas, error
    onvolver()
  }
  class "nucleo/nucleo.js y nucleo.d.ts" as generado <<generado>> {
    las funciones de wasm.rs
    los tipos <<tsify>>
  }
}

funciones ..> Examen : lee
funciones ..> Pregunta : lee
funciones ..> Respuesta : lee
funciones ..> Concepto : calcula el paso
funciones ..> Azar : baraja
funciones --> Inicio : devuelve
Inicio *-- Tarjeta
Tarjeta *-- Dudas
funciones --> PreguntaDeSesion : devuelve
Pregunta *-- Fuente
funciones --> Columnas : mover()
funciones ..> Tirador : lee
funciones --> Simulacro : devuelve
Simulacro *-- PreguntaDeSesion
funciones ..> Cierre : lee
Cierre *-- Resultado
Respuesta *-- Resultado
Correccion *-- Respuesta
funciones --> Correccion : corregir()
Datos *-- Examen
Datos *-- Pregunta
Datos *-- Respuesta
funciones --> NotaDelSimulacro : devuelve
funciones ..> Guardado : elige el más nuevo
Guardado *-- RondaGuardada
funciones --> RondaAMedias : devuelve
RondaAMedias *-- PreguntaDeSesion
ordenes ..> herramientas : llama
herramientas ..> ExamenBanco : lee examen.json
herramientas ..> Pregunta : lee preguntas.json
rutas *-- Carpetas : estado
rutas ..> lectura : lee la carpeta
rutas ..> Datos : devuelve
rutas ..> Respuesta : valida
rutas ..> Guardado : valida y guarda el más nuevo
rutas ..> Nota : valida y guarda
rutas ..> funciones : gana()
wasm ..> funciones : llama
wasm ..> generado : wasm-bindgen genera
App ..> generado : importa y llama
App ..> rutas : HTTP
App *-- InicioSvelte : props y callbacks
App *-- PreguntaSvelte
App *-- Hoja
App *-- Tiradores
App *-- PaginaCompleta
App *-- Final
@enduml

@startuml la-ronda
!pragma layout smetana
skinparam shadowing false
title La ronda en App.svelte\nCada flecha lleva la función que hace el cambio\nempezar, contestar, terminar y volver llaman a guardar()

state Inicio
state "Pregunta { contestada: false }" as SinContestar
state "Pregunta { contestada: true }" as Contestada
state Final

[*] --> Inicio
[*] --> SinContestar : arrancar() → seguir(), con una ronda a medias
[*] --> Final : arrancar() → seguir() → terminar(), sin preguntas por contestar
Inicio --> SinContestar : empezar(comoSimulacro)
SinContestar --> Contestada : contestar(opcion, seguro)
SinContestar --> Contestada : contestar(null), "En blanco" del simulacro
Contestada --> SinContestar : siguiente(), quedan preguntas
Contestada --> Final : siguiente() → terminar(), la última
SinContestar --> Final : contar() → terminar(), el límite del simulacro
Contestada --> Final : contar() → terminar(), el límite del simulacro
SinContestar --> Inicio : abandonar(), el botón ✕
Contestada --> Inicio : abandonar(), el botón ✕
Final --> Inicio : volver()
@enduml

@startuml el-viaje-de-una-sesion
skinparam shadowing false
title El viaje de una sesión

participant "App.svelte" as App
participant "nucleo (WASM)" as N
participant servidor as S
database "carpeta del examen" as C

App -> S : GET api/inicio
S -> C : examen.json, preguntas.json, respuestas.jsonl
S --> App : Datos { examen, banco, historial }
App -> N : unir(historial, pendientes)
N --> App : el historial de la pantalla
App -> N : inicio(datos, objetivo)
N --> App : Inicio (BancoVacio o Listo)

App -> N : sesion(datos, Date.now())
N --> App : 12 PreguntaDeSesion

loop cada pregunta
  App -> N : corregir(pregunta, opcion, seguro, Date.now())
  N --> App : Correccion, con la respuesta en blanco sin opción
  note over App : la respuesta entra en localStorage <examen>-pendientes,\ny datos.historial = unir(historial, [respuesta])
  App -> S : POST api/respuestas, con todas las pendientes
  alt con red
    S -> C : añade a respuestas.jsonl las que no están
    S --> App : 204
    note over App : las enviadas salen de las pendientes
  else sin red
    note over App : las pendientes esperan al evento online o a la carga siguiente
  end
  note over App : muestra el paso y el aviso de la corrección
end
@enduml

@startuml el-final-de-un-simulacro
skinparam shadowing false
title El final de un simulacro

participant "App.svelte" as App
participant "nucleo (WASM)" as N
participant servidor as S

App -> N : simulacro(datos, Date.now())
N --> App : Simulacro { segundos, preguntas }
note over App : limite = Date.now() + segundos × 1000, y vive en el guardado de la ronda
loop cada segundo, contar()
  App -> N : restante(limite, Date.now())
  N --> App : segundos que quedan; a 0, terminar()
end
note over App : cada respuesta va a POST api/respuestas, como en la sesión;\nuna pregunta sin contestar al pasar el límite no va
App -> N : nota({ preguntas, resultados }, penalizacion)
note over N : cada pregunta sin resultado cuenta en blanco
N --> App : NotaDelSimulacro
@enduml
