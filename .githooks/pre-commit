#!/bin/sh
# Corre los tests si el commit cambia app/, y banco comprobar en cada examen cuyo banco cambia.
# ponytail: comprueba el árbol de trabajo y no el stage; un stash del resto si un commit parcial lo necesita.
set -e
# Un movimiento sin cambios (R100) no cambia el contenido: el hook lo salta, y lee la ruta nueva de los demás.
cambios=$(git diff --cached --name-status | awk -F'\t' '$1 != "R100" { print $NF }')
if echo "$cambios" | grep -v '\.md$' | grep -q '^app/'; then
  cargo test -q --manifest-path app/Cargo.toml
fi
for ex in $(echo "$cambios" | grep -E '^examenes/[^/]+/(preguntas|examen)\.json$' | cut -d/ -f1-2 | sort -u); do
  cargo run -q --manifest-path app/Cargo.toml -p banco -- comprobar "$ex" >/dev/null || {
    echo "banco comprobar $ex falla: corre el comando para ver el informe" >&2
    exit 1
  }
done
