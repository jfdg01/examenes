{
  "name": "interfaz",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "cargo build -p nucleo --release --target wasm32-unknown-unknown && wasm-bindgen --target web --out-dir src/nucleo ../target/wasm32-unknown-unknown/release/nucleo.wasm",
    "prebuild": "npm run wasm",
    "build": "svelte-check --fail-on-warnings && vite build",
    "predev": "npm run wasm",
    "dev": "vite",
    "comprobar": "node comprobar.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/svelte": "^5.0.9",
    "playwright": "^1.65.1",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
