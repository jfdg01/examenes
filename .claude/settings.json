{
  "permissions": {
    "deny": [
      "Edit(examenes/asn/**)",
      "Write(examenes/asn/**)",
      "Edit(examenes/ca/**)",
      "Write(examenes/ca/**)",
      "Edit(examenes/*/respuestas.jsonl)",
      "Write(examenes/*/respuestas.jsonl)",
      "Edit(examenes/*/desarrollo.jsonl)",
      "Write(examenes/*/desarrollo.jsonl)",
      "Edit(examenes/*/ronda.json)",
      "Write(examenes/*/ronda.json)",
      "Edit(examenes/*/notas.json)",
      "Write(examenes/*/notas.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/comprobar-banco.sh" }]
      }
    ]
  }
}
